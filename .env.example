# ---- REQUIRED: from https://my.telegram.org → API development tools ----
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here
TG_PHONE=+251900000000          # international format; used at first login

# ---- Digest behaviour ----
DIGEST_CHANNEL_TITLE=My Daily Digest    # auto-created as a private channel if missing
DIGEST_TIME=08:00                       # local time of the machine running it
SESSION_PATH=session/tdigest
STATE_PATH=tdigest.db
INTERESTS_PATH=interests.yaml

# ---- Safety dials (defaults are sensible) ----
SLEEP_BETWEEN_CHANNELS=0.5      # seconds; raise to 1-2 if you see FloodWait often
MAX_MESSAGES_PER_CHANNEL=400    # per run, newest first
FIRST_RUN_LOOKBACK_HOURS=24     # how far back the very first run looks
LOOKBACK_CAP_HOURS=72           # max catch-up window if the bot was off for days
INCLUDE_MEDIA_ONLY=false        # include posts with zero text? (can't be matched)
SEND_EMPTY_DIGEST=false         # send a message even on days with zero matches
SEND_SILENT=false               # deliver digest without notification sound
VIRAL_THRESHOLD=150.0           # velocity threshold to trigger trending 🔥 badge
SHOW_ENGAGEMENT_METRICS=true    # display views, forwards & reactions metrics in digest

# ---- AI semantic matching: off | openai | local ----
# local  = free & private, needs: pip install sentence-transformers (~1-2 GB once)
# openai = needs OPENAI_API_KEY; ~$0.00002 per 1k posts with text-embedding-3-small
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=
